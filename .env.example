# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Credentials are read from the environment only. Nothing in this project
# writes a credential to disk, and no file in the repository should ever
# contain one. If a library you add caches derived API credentials next to
# the code, add that filename to .gitignore before running it once.

ASTERDEX_API_KEY=
ASTERDEX_API_SECRET=

# Start in dry run. Set to false only once paper trading has convinced you.
BOT_DRY_RUN=true

# Comma-separated.
BOT_SYMBOLS=BTCUSDT,ETHUSDT

BOT_STRATEGY=macd_flip
BOT_LEVERAGE=3
BOT_MARGIN_PER_TRADE=10
BOT_STOP_PCT=0.024
BOT_TARGET_PCT=0.060
